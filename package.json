{
	"name": "block-for-strava",
	"version": "1.0.0",
	"private": true,
	"description": "Embed public Strava activities on your WordPress site.",
	"author": "Konstantin Obenland",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"strava",
		"block",
		"embed",
		"gutenberg"
	],
	"homepage": "https://wordpress.org/plugins/block-for-strava/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/obenland/block-for-strava.git"
	},
	"bugs": {
		"url": "https://github.com/obenland/block-for-strava/issues"
	},
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@wordpress/api-fetch": "^7.48.0",
		"@wordpress/element": "^8.0.0",
		"@wordpress/env": "11.8.0",
		"@wordpress/escape-html": "^3.47.0",
		"@wordpress/eslint-plugin": "^25.3.0",
		"@wordpress/hooks": "^4.46.0",
		"@wordpress/i18n": "^6.21.0",
		"@wordpress/icons": "^14.0.0",
		"@wordpress/scripts": "^32.4.0",
		"prettier": "npm:wp-prettier@3.0.3"
	},
	"overrides": {
		"copy-webpack-plugin": {
			"serialize-javascript": "^7.0.5"
		},
		"markdownlint-cli": {
			"minimatch": "^3.1.5"
		},
		"sockjs": {
			"uuid": "^14.0.0"
		},
		"webpack-dev-server": "^5.2.3"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-env start",
		"start:tests": "wp-env start --config .wp-env.tests.json",
		"start:all": "npm run start && npm run start:tests",
		"stop": "wp-env stop",
		"stop:tests": "wp-env stop --config .wp-env.tests.json",
		"stop:all": "npm run stop && npm run stop:tests",
		"destroy": "wp-env destroy",
		"destroy:tests": "wp-env destroy --config .wp-env.tests.json",
		"destroy:all": "npm run destroy && npm run destroy:tests",
		"dev": "wp-scripts start",
		"lint": "npm run lint:php && npm run lint:js && npm run lint:css && npm run lint:md && npm run lint:pkg-json",
		"lint:fix": "npm run lint:php:fix && npm run lint:js:fix && npm run lint:css:fix",
		"lint:php": "wp-env run cli --env-cwd=wp-content/plugins/block-for-strava ./vendor/bin/phpcs",
		"lint:php:fix": "wp-env run cli --env-cwd=wp-content/plugins/block-for-strava ./vendor/bin/phpcbf",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"lint:css": "wp-scripts lint-style 'src/**/*.scss' --allow-empty-input",
		"lint:css:fix": "wp-scripts lint-style 'src/**/*.scss' --allow-empty-input --fix",
		"lint:md": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"format": "wp-scripts format",
		"check-types": "tsc --noEmit",
		"test": "npm run test:php && npm run test:unit:js",
		"test:php": "wp-env run cli --config .wp-env.tests.json --env-cwd=/var/www/html/wp-content/plugins/block-for-strava composer test",
		"test:php:multisite": "wp-env run cli --config .wp-env.tests.json --env-cwd=/var/www/html/wp-content/plugins/block-for-strava composer test-multisite",
		"test:php:coverage": "wp-env run cli --config .wp-env.tests.json --env-cwd=/var/www/html/wp-content/plugins/block-for-strava composer test-coverage",
		"test:unit:js": "wp-scripts test-unit-js",
		"test:unit:js:watch": "wp-scripts test-unit-js --watch",
		"test:unit:js:coverage": "wp-scripts test-unit-js --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:install": "playwright install --with-deps chromium",
		"wp-env": "wp-env"
	}
}
