{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "obenland/strava-activity",
	"version": "1.0.0",
	"title": "Strava Activity",
	"category": "embed",
	"icon": "chart-area",
	"description": "Embed a public Strava activity on your site.",
	"keywords": [
		"strava",
		"activity",
		"embed",
		"running",
		"cycling",
		"fitness"
	],
	"textdomain": "block-for-strava",
	"attributes": {
		"url": {
			"type": "string",
			"default": ""
		},
		"activityId": {
			"type": "string",
			"default": ""
		},
		"token": {
			"type": "string",
			"default": ""
		},
		"caption": {
			"type": "string",
			"source": "html",
			"selector": "figcaption",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"__experimentalDefaultControls": {
				"margin": true
			}
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
