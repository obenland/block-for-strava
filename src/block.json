{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "block-for-strava/embed",
	"version": "1.0.0",
	"title": "Strava",
	"category": "embed",
	"description": "Embed a public Strava activity, route, or segment, or a Strava share-dialog snippet.",
	"keywords": [
		"strava",
		"activity",
		"route",
		"segment",
		"fitness",
		"running",
		"cycling"
	],
	"textdomain": "block-for-strava",
	"icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M11.25 5h1.5v15h-1.5V5zM6 10h1.5v10H6V10zm12 4h-1.5v6H18v-6z\"/></svg>",
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"interactivity": { "clientNavigation": true }
	},
	"attributes": {
		"url": {
			"type": "string"
		},
		"stravaRouteMapStyle": {
			"type": "string",
			"default": "standard",
			"enum": [
				"standard",
				"satellite",
				"hybrid",
				"dark",
				"winter",
				"light"
			]
		},
		"stravaRouteTerrain": {
			"type": "string",
			"default": "auto",
			"enum": [ "auto", "2d", "3d" ]
		},
		"stravaRouteUnits": {
			"type": "string",
			"default": "auto",
			"enum": [ "auto", "metric", "imperial" ]
		},
		"stravaRouteFullWidth": {
			"type": "boolean",
			"default": false
		},
		"stravaRouteShowDirt": {
			"type": "boolean",
			"default": false
		},
		"stravaRouteShowElevation": {
			"type": "boolean",
			"default": true
		},
		"stravaEmbedToken": {
			"type": "string",
			"default": ""
		},
		"caption": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js"
}
