{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "block-for-strava/embed",
	"version": "1.0.0",
	"title": "Strava",
	"category": "embed",
	"description": "Embed Strava activities, routes, and segments with their live interactive map and elevation profile. Paste a URL to start; route options for map style, terrain, and units sit in the inspector.",
	"keywords": [
		"strava",
		"activity",
		"route",
		"segment",
		"fitness",
		"running",
		"cycling"
	],
	"textdomain": "block-for-strava",
	"icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M2 20 L8 9 L12 15 L18 5 L22 20 Z\"/></svg>",
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"interactivity": { "clientNavigation": true },
		"spacing": {
			"margin": true,
			"__experimentalDefaultControls": {
				"margin": true
			}
		}
	},
	"attributes": {
		"url": {
			"type": "string"
		},
		"stravaRouteMapStyle": {
			"type": "string",
			"default": "standard",
			"enum": [
				"standard",
				"satellite",
				"hybrid",
				"dark",
				"winter",
				"light"
			]
		},
		"stravaRouteTerrain": {
			"type": "string",
			"default": "auto",
			"enum": [ "auto", "2d", "3d" ]
		},
		"stravaRouteUnits": {
			"type": "string",
			"default": "auto",
			"enum": [ "auto", "metric", "imperial" ]
		},
		"stravaRouteFullWidth": {
			"type": "boolean",
			"default": false
		},
		"stravaRouteShowDirt": {
			"type": "boolean",
			"default": false
		},
		"stravaRouteShowElevation": {
			"type": "boolean",
			"default": true
		},
		"stravaEmbedToken": {
			"type": "string",
			"default": ""
		},
		"caption": {
			"type": "string",
			"default": ""
		}
	},
	"example": {
		"viewportWidth": 600,
		"attributes": {
			"url": "https://www.strava.com/routes/3379104463896442748",
			"stravaRouteMapStyle": "satellite",
			"stravaRouteTerrain": "3d",
			"stravaRouteShowElevation": true
		}
	},
	"editorScript": "file:./index.js"
}
