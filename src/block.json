{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "obenland/strava-activity",
	"version": "1.0.0",
	"title": "Strava Activity",
	"category": "embed",
	"icon": "chart-bar",
	"description": "Embed a public Strava activity, route, or segment on your site.",
	"keywords": [
		"strava",
		"activity",
		"route",
		"segment",
		"embed",
		"running",
		"cycling",
		"fitness"
	],
	"textdomain": "block-for-strava",
	"attributes": {
		"url": {
			"type": "string",
			"default": ""
		},
		"activityId": {
			"type": "string",
			"default": ""
		},
		"embedType": {
			"type": "string",
			"default": "activity",
			"enum": ["activity", "route", "segment"]
		},
		"caption": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"interactivity": {
			"clientNavigation": true
		},
		"spacing": {
			"margin": true,
			"__experimentalDefaultControls": {
				"margin": true
			}
		}
	},
	"example": {
		"attributes": {
			"url": "https://www.strava.com/activities/18233733854",
			"activityId": "18233733854",
			"embedType": "activity"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
