{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"lib": ["ES2020", "DOM"],
		"strict": true,
		"jsx": "react",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"paths": {
			"@wordpress/*": ["./node_modules/@wordpress/*"]
		}
	},
	"include": ["src/**/*", "tests/e2e/**/*"]
}
